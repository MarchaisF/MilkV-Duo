# Kernel config fragment: disable the DVB/DTV frontend and tuner drivers.
#
# The vendor defconfig leaves CONFIG_MEDIA_SUBDRV_AUTOSELECT unset, which
# (per drivers/media/dvb-frontends/Kconfig) makes every single DVB frontend
# and tuner driver default to "m" -- about 110 modules that are useless on
# this board (no DVB/DTV tuner hardware exists) and only cost build time and
# eMMC space.
#
# Setting this symbol to "y" restores normal auto-selection (only build
# drivers actually required by enabled hardware). This only affects symbols
# that don't already have an explicit value in the .config, so build_sdk.sh
# additionally strips pre-existing "CONFIG_DVB_*" assignments before merging
# this fragment and running olddefconfig -- see strip_dvb_config() there.
CONFIG_MEDIA_SUBDRV_AUTOSELECT=y
