# Kernel config fragment: network boot via TFTP (kernel) + NFS (rootfs).
# Based on:
# https://github.com/MarchaisF/MilkV-Duo/blob/main/Add TFTP - NFS boot capabilities.md
#
# Note: the SG2000 Ethernet driver (CONFIG_STMMAC_ETH) is already builtin
# in the vendor defconfig, so it is not repeated here.

# IP autoconfiguration at kernel level (get an address without a userspace daemon)
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IP_PNP_RARP=y

# NFS client + root-on-NFS support
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
