# Kernel config fragment: SPI TFT display support (ILI9488 / SPFD5408 panels).
#
# The vendor defconfig already enables the fbtft framework (CONFIG_FB_TFT),
# CONFIG_STAGING, CONFIG_SPI and CONFIG_GPIOLIB (used for an on-board ST7789V
# display), so only the two extra panel drivers need to be turned on:
#   - ILI9488 panel  -> handled by the generic ili9486 fbtft driver
#   - SPFD5408 panel -> handled by the generic ili9341 fbtft driver
CONFIG_FB_TFT_ILI9341=y
CONFIG_FB_TFT_ILI9486=y
