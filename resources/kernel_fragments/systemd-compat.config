# Kernel config fragment: minimal options required by systemd on a Debian rootfs.
#
# systemd hard requirements:
#   - cgroup v1 hierarchy (CGROUPS + key subsystems)
#   - devtmpfs (device nodes populated by the kernel before udev)
#   - autofs4 (automount, used internally by systemd)
#   - fanotify (used by systemd-udevd for inotify-based events)
#
# Without CONFIG_CGROUPS, systemd prints:
#   [!!!!!!] Failed to mount cgroup v1 hierarchy.
# and freezes at boot.

# --- cgroup v1 core ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y

# --- autofs (systemd automount unit) ---
CONFIG_AUTOFS4_FS=y

# --- devtmpfs (populated /dev at early boot) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- fanotify (inotify extension, used by systemd-udevd) ---
CONFIG_FANOTIFY=y
