# Kernel config fragment: standard firmware path for the AIC8800 Wi-Fi/BT chip.
#
# The vendor defconfig ships an Android-style firmware location:
#   CONFIG_AIC_FW_PATH="/mnt/system/firmware/aic8800"
# which does not exist on a Debian FHS rootfs, so the aic8800 driver fails to
# load its firmware blobs at probe time (see "dmesg | grep -i aic").
#
# Point it at the standard Linux firmware directory instead. build_sdk.sh
# deploys the blobs there (see install_aic8800_firmware(), which copies
# device/generic/rootfs_overlay/duos/mnt/system/firmware/aic8800 into
# <rootfs>/lib/firmware/aic8800).
#
# Note: this is a *string* symbol, so merge_config.sh overrides the vendor
# value rather than adding a second one.
CONFIG_AIC_FW_PATH="/lib/firmware/aic8800"
